[package]
-> name        => h2d
-> version     => 0.3.0
-> description => 2D game engine for H#: windowed GPU graphics (SDL2), tile maps + physics, particles, UI, scenes, audio, gamepad, TrueType text. Also the older character-grid ANSI text engine for turn-based games.
-> authors     => ["Bit Developers"]
-> license     => MIT
-> lang        => h#

[edition]
-> edition   => 2026
-> toolchain => 0.9

[layout]
-> src      => src
-> tests    => tests
-> examples => examples

[build]
-> link             => static
-> native           => ./native/build.sh
-> native-lib-path  => build

[lib]
-> output => hlib

[pack]
-> contents    => [hlib, sources, docs]
-> compression => zstd

[dependencies]

[commands]
-> native
--> run => ./native/build.sh
--> description => Build libh2d_native.a (needs the SDL2 dev packages, see [system-dependencies])
-> test
--> run => ./tests/run.sh
--> description => Run the window-less logic tests (tests/logic_test.h#)
-> platformer
--> run => ./scripts/run-example.sh platformer
--> description => Build and run the platformer demo (tiles, physics, particles, UI, scenes)
-> pong
--> run => ./scripts/run-example.sh pong
--> description => Build and run the two-player Pong demo
-> sokoban
--> run => ./scripts/run-example.sh sokoban
--> description => Build and run the text-engine Sokoban demo (terminal)

[system-dependencies]
-> sdl2
--> pkg-config => sdl2
--> header => SDL2/SDL.h
--> lib => SDL2
--> apt => libsdl2-dev
--> dnf => SDL2-devel
--> pacman => sdl2
--> apk => sdl2-dev
--> zypper => libSDL2-devel
--> brew => sdl2
-> SDL2_image
--> pkg-config => SDL2_image
--> header => SDL2/SDL_image.h
--> lib => SDL2_image
--> apt => libsdl2-image-dev
--> dnf => SDL2_image-devel
--> pacman => sdl2_image
--> apk => sdl2_image-dev
--> zypper => libSDL2_image-devel
--> brew => sdl2_image
-> SDL2_mixer
--> pkg-config => SDL2_mixer
--> header => SDL2/SDL_mixer.h
--> lib => SDL2_mixer
--> apt => libsdl2-mixer-dev
--> dnf => SDL2_mixer-devel
--> pacman => sdl2_mixer
--> apk => sdl2_mixer-dev
--> zypper => libSDL2_mixer-devel
--> brew => sdl2_mixer
-> SDL2_gfx
--> pkg-config => SDL2_gfx
--> header => SDL2/SDL2_gfxPrimitives.h
--> lib => SDL2_gfx
--> apt => libsdl2-gfx-dev
--> dnf => SDL2_gfx-devel
--> pacman => sdl2_gfx
--> apk => sdl2_gfx-dev
--> zypper => libSDL2_gfx-devel
--> brew => sdl2_gfx
-> SDL2_ttf
--> pkg-config => SDL2_ttf
--> header => SDL2/SDL_ttf.h
--> lib => SDL2_ttf
--> apt => libsdl2-ttf-dev
--> dnf => SDL2_ttf-devel
--> pacman => sdl2_ttf
--> apk => sdl2_ttf-dev
--> zypper => libSDL2_ttf-devel
--> brew => sdl2_ttf
