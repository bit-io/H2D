;; ── TrueType fonts (UTF-8: "zażółć gęślą jaźń" works) ────────────────

;; A loaded TTF/OTF font at a fixed point size. handle == 0 means loading
;; failed (bad path); drawing with it is then a silent no-op, so check
;; `font.handle != 0` or fall back to draw_text().
pub struct Font is
    pub handle: int
    pub size:   int
end

pub fn load_font(path: string, pt_size: int) -> Font is
    return Font { handle: h2d_load_font(path, pt_size), size: pt_size }
end

pub fn is_font_valid(f: Font) -> bool is
    return f.handle != 0
end

pub fn unload_font(f: Font) is
    if f.handle != 0 is h2d_unload_font(f.handle) end
end

;; Rendered strings are cached, so calling this every frame is cheap.
pub fn draw_text_font(f: Font, text: string, x: f64, y: f64, c: h2d_color::Color) is
    h2d_draw_text_font(f.handle, text, x, y, c.r, c.g, c.b, c.a)
end

pub fn measure_text_font(f: Font, text: string) -> int is
    return h2d_measure_text_font(f.handle, text)
end

pub fn font_height(f: Font) -> int is
    return h2d_font_height(f.handle)
end

