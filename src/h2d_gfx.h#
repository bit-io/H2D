;; ── window control ───────────────────────────────────────────────────

pub fn set_window_size(w: int, h: int) is h2d_set_window_size(w, h) end
pub fn set_window_min_size(w: int, h: int) is h2d_set_window_min_size(w, h) end

;; Borderless "desktop" fullscreen on/off. Toggle with e.g. F11.
pub fn set_fullscreen(on: bool) is
    h2d_set_fullscreen(if on then 1 else 0)
end

pub fn is_fullscreen() -> bool is
    return h2d_is_fullscreen() != 0
end

pub fn toggle_fullscreen() is
    set_fullscreen(!is_fullscreen())
end

;; Virtual resolution. After `set_logical_size(320, 180)` you draw in a
;; 320x180 world and H2D scales + letterboxes it to whatever the window
;; is — the standard way to make pixel-art games resolution independent.
;; screen_width()/screen_height() then return 320/180 and mouse
;; coordinates are reported in the same virtual space. (0, 0) turns it off.
pub fn set_logical_size(w: int, h: int) is h2d_set_logical_size(w, h) end

;; With a logical size set: only scale by whole numbers (no shimmering pixels).
pub fn set_integer_scale(on: bool) is
    h2d_set_integer_scale(if on then 1 else 0)
end

pub fn show_cursor(on: bool) is
    h2d_show_cursor(if on then 1 else 0)
end

;; Captures the mouse (for mouse-look / drag scrolling); mouse_dx/dy then report motion.
pub fn set_relative_mouse(on: bool) is
    h2d_set_relative_mouse(if on then 1 else 0)
end

pub fn set_window_icon(path: string) is h2d_set_window_icon(path) end

;; Makes window_should_close() true (e.g. from a "Quit" menu button).
pub fn request_close() is h2d_request_close() end

;; Smoothed frames-per-second, for a debug overlay.
pub fn get_fps() -> f64 is return h2d_get_fps() end
pub fn get_frame_count() -> int is return h2d_get_frame_count() end
pub fn get_ticks_ms() -> int is return h2d_get_ticks_ms() end

;; Saves the frame drawn so far as PNG (call before next_frame()). True on success.
pub fn save_screenshot(path: string) -> bool is
    return h2d_save_screenshot(path) != 0
end

;; ── blend / clipping ─────────────────────────────────────────────────

pub fn blend_none() -> int is return 0 end
pub fn blend_alpha() -> int is return 1 end
pub fn blend_add() -> int is return 2 end
pub fn blend_multiply() -> int is return 3 end

;; Blend mode for rectangles and textures drawn afterwards (default: alpha).
;; Additive is what glows, fire and magic particles want.
pub fn set_blend_mode(mode: int) is h2d_set_blend_mode(mode) end

;; Only pixels inside the rectangle are drawn until clear_clip() — scroll
;; panels, minimaps, split-screen.
pub fn set_clip(x: f64, y: f64, w: f64, h: f64) is h2d_set_clip(x, y, w, h) end
pub fn clear_clip() is h2d_clear_clip() end

