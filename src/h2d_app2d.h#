mod h2d_gfx
mod h2d_entity2d
mod h2d_camera2d

;; Convenience bundle for h2d_gfx's graphics engine — the pixel-graphics
;; counterpart to h2d_app.h#'s Canvas/World/Clock bundle for the text
;; engine (kept as-is; separate struct). Entirely optional: everything
;; here is a thin wrapper over h2d_gfx/h2d_entity2d/h2d_camera2d calls
;; you can just make directly if you'd rather not use one struct for
;; "the whole app".

pub struct App2D is
    pub world:  h2d_entity2d::World2D
    pub camera: h2d_camera2d::Camera2D
    pub running: bool
end

;; Opens the window (see h2d_gfx::init_window) and returns a ready-to-use
;; App2D with an empty World2D and a camera centered on the window.
;; `title` is the window title bar text.
pub fn new_app2d(width: int, height: int, title: string, target_fps: int) -> App2D is
    h2d_gfx::init_window(width, height, title)
    h2d_gfx::set_target_fps(target_fps)
    return App2D {
        world: h2d_entity2d::new_world2d(),
        camera: h2d_camera2d::new_camera2d_centered(width, height),
        running: true,
    }
end

;; True while the window is open and nothing has asked to quit —
;; combines h2d_gfx::window_should_close() with the app's own
;; `running` flag (set false by your own game-over/menu-quit logic via
;; `app.running = false` — H# structs mutate through the owning
;; variable directly, no setter needed).
pub fn is_running(app: App2D) -> bool is
    return app.running && !h2d_gfx::window_should_close()
end

;; Ends the current frame and begins the next (see h2d_gfx::next_frame).
pub fn next_frame(app: App2D) is
    h2d_gfx::next_frame()
end

pub fn shutdown(app: App2D) is
    h2d_gfx::close_window()
end

;; Like new_app2d, but the game draws in a fixed virtual resolution
;; (virtual_w x virtual_h) that is scaled + letterboxed into a resizable
;; window of window_w x window_h. `integer_scale` keeps pixels square and
;; crisp. screen_width()/screen_height() and the mouse then use the virtual
;; size, and the camera is centred on it.
pub fn new_app2d_virtual(virtual_w: int, virtual_h: int, window_w: int, window_h: int, title: string, target_fps: int, integer_scale: bool) -> App2D is
    h2d_gfx::init_window(window_w, window_h, title)
    h2d_gfx::set_target_fps(target_fps)
    h2d_gfx::set_logical_size(virtual_w, virtual_h)
    h2d_gfx::set_integer_scale(integer_scale)
    return App2D {
        world: h2d_entity2d::new_world2d(),
        camera: h2d_camera2d::new_camera2d_centered(virtual_w, virtual_h),
        running: true,
    }
end
