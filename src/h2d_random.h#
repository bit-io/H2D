use "std -> crypto" from "crypto"

;; Inclusive on both ends: range(1, 6) can return 1 or 6.
pub fn range(min: int, max: int) -> int is
    return crypto::random_int(min, max)
end

;; True `percent` percent of the time (0-100).
pub fn chance(percent: int) -> bool is
    return range(1, 100) <= percent
end

pub fn coin_flip() -> bool is
    return range(0, 1) == 1
end

;; dice(6) == a d6 roll, 1..=6.
pub fn dice(sides: int) -> int is
    return range(1, sides)
end

;; Sum of `count` rolls of a `sides`-sided die, e.g. roll_dice(2, 6) for 2d6.
pub fn roll_dice(count: int, sides: int) -> int is
    let mut total: int = 0
    let mut i: int = 0
    while i < count is
        total += dice(sides)
        i += 1
    end
    return total
end

;; Uniform random element. Caller must ensure the array isn't empty.
pub fn choice_int(arr: [int]) -> int is
    return arr[range(0, arr.len() - 1)]
end

pub fn choice_string(arr: [string]) -> string is
    return arr[range(0, arr.len() - 1)]
end

;; Fisher-Yates shuffle. Returns a new array; does not touch the original.
pub fn shuffle_ints(arr: [int]) -> [int] is
    let mut out: [int] = arr
    let mut i: int = out.len() - 1
    while i > 0 is
        let j: int = range(0, i)
        let tmp: int = out[i]
        out[i] = out[j]
        out[j] = tmp
        i -= 1
    end
    return out
end

pub fn shuffle_strings(arr: [string]) -> [string] is
    let mut out: [string] = arr
    let mut i: int = out.len() - 1
    while i > 0 is
        let j: int = range(0, i)
        let tmp: string = out[i]
        out[i] = out[j]
        out[j] = tmp
        i -= 1
    end
    return out
end

;; ── 0.3.0: seedable, reproducible generator ─────────────────────────────
;; The functions above use the OS CSPRNG (unseedable, slow-ish). Games want
;; a deterministic generator: same seed = same dungeon / same replay.
;; Park-Miller "minimal standard" (state in 1..2147483646), pure H#.

pub struct Rng is
    pub state: int
end

pub fn new_rng(seed: int) -> Rng is
    let mut s: int = seed % 2147483646
    if s < 0 is s = 0 - s end
    if s == 0 is s = 1 end
    return Rng { state: s }
end

;; Advances the generator; returns (rng, value in 0 .. 2147483645).
pub fn rng_next(mut r: Rng) -> (Rng, int) is
    r.state = (r.state * 48271) % 2147483647
    return (r, r.state - 1)
end

;; Inclusive on both ends.
pub fn rng_range(mut r: Rng, lo: int, hi: int) -> (Rng, int) is
    let n = rng_next(r)
    let span: int = hi - lo + 1
    if span <= 0 is return (n.0, lo) end
    return (n.0, lo + n.1 % span)
end

;; Uniform float in [0.0, 1.0).
pub fn rng_f64(mut r: Rng) -> (Rng, f64) is
    let n = rng_next(r)
    return (n.0, (n.1 + 0.0) / 2147483646.0)
end

pub fn rng_range_f(mut r: Rng, lo: f64, hi: f64) -> (Rng, f64) is
    let n = rng_f64(r)
    return (n.0, lo + (hi - lo) * n.1)
end

pub fn rng_chance(mut r: Rng, percent: int) -> (Rng, bool) is
    let n = rng_range(r, 1, 100)
    return (n.0, n.1 <= percent)
end
