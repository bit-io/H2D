mod h2d_vec2

;; Pixel/world-space collision for h2d_gfx's graphics engine — the
;; float counterpart to h2d_collision.h#'s grid-cell integer collision
;; for the text engine (kept as-is; separate module, since AABBs here
;; are float rectangles in continuous space, not integer grid cells).

pub fn point_in_rect(px: f64, py: f64, rx: f64, ry: f64, rw: f64, rh: f64) -> bool is
    return px >= rx && py >= ry && px < rx + rw && py < ry + rh
end

pub fn rects_intersect(ax: f64, ay: f64, aw: f64, ah: f64, bx: f64, by: f64, bw: f64, bh: f64) -> bool is
    return ax < bx + bw && ax + aw > bx && ay < by + bh && ay + ah > by
end

;; Overlap rectangle of two intersecting AABBs, as (x, y, w, h) — width
;; and/or height are <= 0.0 if the rects don't actually overlap (check
;; rects_intersect first if you just need the yes/no).
pub fn intersection_rect(ax: f64, ay: f64, aw: f64, ah: f64, bx: f64, by: f64, bw: f64, bh: f64) -> (f64, f64, f64, f64) is
    let x1: f64 = f64_max(ax, bx)
    let y1: f64 = f64_max(ay, by)
    let x2: f64 = f64_min(ax + aw, bx + bw)
    let y2: f64 = f64_min(ay + ah, by + bh)
    return (x1, y1, x2 - x1, y2 - y1)
end

pub fn circles_intersect(ax: f64, ay: f64, aradius: f64, bx: f64, by: f64, bradius: f64) -> bool is
    let dx: f64 = ax - bx
    let dy: f64 = ay - by
    let dist_sq: f64 = dx * dx + dy * dy
    let r_sum: f64 = aradius + bradius
    return dist_sq <= r_sum * r_sum
end

;; Closest point on AABB (rx, ry, rw, rh) to (cx, cy), used internally
;; by circle_rect_intersect — exposed too since it's handy on its own
;; for e.g. clamping an entity to a room's bounds.
pub fn closest_point_on_rect(px: f64, py: f64, rx: f64, ry: f64, rw: f64, rh: f64) -> (f64, f64) is
    let cx: f64 = f64_clamp(px, rx, rx + rw)
    let cy: f64 = f64_clamp(py, ry, ry + rh)
    return (cx, cy)
end

pub fn circle_rect_intersect(cx: f64, cy: f64, radius: f64, rx: f64, ry: f64, rw: f64, rh: f64) -> bool is
    let closest = closest_point_on_rect(cx, cy, rx, ry, rw, rh)
    let dx: f64 = cx - closest.0
    let dy: f64 = cy - closest.1
    return (dx * dx + dy * dy) <= radius * radius
end

pub fn distance(ax: f64, ay: f64, bx: f64, by: f64) -> f64 is
    let v: h2d_vec2::Vec2 = h2d_vec2::vec2(ax - bx, ay - by)
    return v.length()
end

fn f64_max(a: f64, b: f64) -> f64 is
    if a > b is return a end
    return b
end

fn f64_min(a: f64, b: f64) -> f64 is
    if a < b is return a end
    return b
end

fn f64_clamp(v: f64, lo: f64, hi: f64) -> f64 is
    if v < lo is return lo end
    if v > hi is return hi end
    return v
end

;; ── 0.3.0 ───────────────────────────────────────────────────────────────

pub fn point_in_circle(px: f64, py: f64, cx: f64, cy: f64, radius: f64) -> bool is
    let dx: f64 = px - cx
    let dy: f64 = py - cy
    return dx * dx + dy * dy <= radius * radius
end

;; Minimum translation to push rectangle A out of rectangle B, as (dx, dy):
;; move A by this vector to separate them along the axis of least overlap.
;; (0.0, 0.0) when they do not overlap.
pub fn separation_vector(ax: f64, ay: f64, aw: f64, ah: f64, bx: f64, by: f64, bw: f64, bh: f64) -> (f64, f64) is
    if !rects_intersect(ax, ay, aw, ah, bx, by, bw, bh) is return (0.0, 0.0) end
    let left: f64 = (bx + bw) - ax          ;; push A to the right by this much
    let right: f64 = (ax + aw) - bx         ;; push A to the left
    let up: f64 = (by + bh) - ay            ;; push A down
    let down: f64 = (ay + ah) - by          ;; push A up
    let mut dx: f64 = left
    if right < left is dx = 0.0 - right end
    let mut dy: f64 = up
    if down < up is dy = 0.0 - down end
    let adx: f64 = if dx < 0.0 then 0.0 - dx else dx
    let ady: f64 = if dy < 0.0 then 0.0 - dy else dy
    if adx < ady is return (dx, 0.0) end
    return (0.0, dy)
end

;; Does the segment (x1,y1)-(x2,y2) cross the rectangle? (line of sight, laser, hitscan)
pub fn segment_hits_rect(x1: f64, y1: f64, x2: f64, y2: f64, rx: f64, ry: f64, rw: f64, rh: f64) -> bool is
    if point_in_rect(x1, y1, rx, ry, rw, rh) || point_in_rect(x2, y2, rx, ry, rw, rh) is return true end
    let mut t0: f64 = 0.0
    let mut t1: f64 = 1.0
    let dx: f64 = x2 - x1
    let dy: f64 = y2 - y1
    let p0: f64 = 0.0 - dx
    let p1: f64 = dx
    let p2: f64 = 0.0 - dy
    let p3: f64 = dy
    let q0: f64 = x1 - rx
    let q1: f64 = rx + rw - x1
    let q2: f64 = y1 - ry
    let q3: f64 = ry + rh - y1
    let ps: [f64] = [p0, p1, p2, p3]
    let qs: [f64] = [q0, q1, q2, q3]
    let mut i: int = 0
    while i < 4 is
        let p: f64 = ps[i]
        let q: f64 = qs[i]
        if p == 0.0 is
            if q < 0.0 is return false end
        else is
            let r: f64 = q / p
            if p < 0.0 is
                if r > t1 is return false end
                if r > t0 is t0 = r end
            else is
                if r < t0 is return false end
                if r < t1 is t1 = r end
            end
        end
        i += 1
    end
    return true
end
