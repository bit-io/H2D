extern static [c, "h2d_native"] is
    fn h2d_audio_init() -> int
    fn h2d_load_sound(path: string) -> int
    fn h2d_play_sound(handle: int)
    fn h2d_play_sound_loop(handle: int)
    fn h2d_set_sound_volume(handle: int, volume: f64)
    fn h2d_stop_all_sounds()
    fn h2d_load_music(path: string) -> int
    fn h2d_play_music(handle: int, do_loop: int)
    fn h2d_stop_music()
    fn h2d_set_music_volume(volume: f64)
end

;; Opens the audio device (44.1kHz stereo). Returns false if the
;; platform has no audio device available (common in CI/headless
;; sandboxes) — every other function in this module is then a safe
;; no-op, so a game doesn't need to branch on this itself unless it
;; wants to warn the player.
pub fn audio_init() -> bool is
    return h2d_audio_init() != 0
end

;; A short sound effect, fully decoded into memory (SDL2_mixer's
;; Mix_Chunk) — right for jumps/hits/coins, wrong for a multi-minute
;; soundtrack (use load_music for that). WAV, OGG, and a few others are
;; supported depending on the SDL2_mixer build; WAV is always safe.
;; `handle == 0` means the load failed (bad path/format, or audio not
;; initialized) — every play_sound* call on an invalid handle is a
;; silent no-op.
pub struct Sound is
    pub handle: int
end

pub fn load_sound(path: string) -> Sound is
    return Sound { handle: h2d_load_sound(path) }
end

pub fn is_valid_sound(s: Sound) -> bool is
    return s.handle != 0
end

pub fn play_sound(s: Sound) is
    h2d_play_sound(s.handle)
end

pub fn play_sound_loop(s: Sound) is
    h2d_play_sound_loop(s.handle)
end

;; volume in [0.0, 1.0].
pub fn set_sound_volume(s: Sound, volume: f64) is
    h2d_set_sound_volume(s.handle, volume)
end

pub fn stop_all_sounds() is
    h2d_stop_all_sounds()
end

;; Streamed background music (SDL2_mixer's Mix_Music) — only one track
;; plays at a time (starting a new one stops whatever was playing), so
;; this models "the current song", not a mixer channel like Sound does.
;; MP3, OGG, and a few others are supported depending on the
;; SDL2_mixer build.
pub struct Music is
    pub handle: int
end

pub fn load_music(path: string) -> Music is
    return Music { handle: h2d_load_music(path) }
end

pub fn is_valid_music(m: Music) -> bool is
    return m.handle != 0
end

pub fn play_music(m: Music, looping: bool) is
    let l: int = if looping then 1 else 0
    h2d_play_music(m.handle, l)
end

pub fn stop_music() is
    h2d_stop_music()
end

;; volume in [0.0, 1.0]. Applies to whichever music is currently
;; playing (SDL2_mixer has one global music volume, not per-track).
pub fn set_music_volume(volume: f64) is
    h2d_set_music_volume(volume)
end

;; ── 0.3.0: unloading, panning, fades, master volume ──────────────────

extern dynamic [c, "h2d_native"] is
    fn h2d_unload_sound(handle: int)
    fn h2d_unload_music(handle: int)
    fn h2d_play_sound_ex(handle: int, volume: f64, pan: f64, do_loop: int) -> int
    fn h2d_stop_channel(ch: int)
    fn h2d_pause_music()
    fn h2d_resume_music()
    fn h2d_is_music_playing() -> int
    fn h2d_fade_in_music(handle: int, do_loop: int, ms: int)
    fn h2d_fade_out_music(ms: int)
    fn h2d_set_master_volume(volume: f64)
end

pub fn unload_sound(s: Sound) is
    if s.handle != 0 is h2d_unload_sound(s.handle) end
end

pub fn unload_music(m: Music) is
    if m.handle != 0 is h2d_unload_music(m.handle) end
end

;; Plays with explicit volume (0..1) and stereo pan (-1 left .. 1 right).
;; Returns the mixer channel (pass to stop_channel for a looping sound),
;; or -1 if it could not play (no audio, invalid sound).
pub fn play_sound_ex(s: Sound, volume: f64, pan: f64, looping: bool) -> int is
    return h2d_play_sound_ex(s.handle, volume, pan, if looping then 1 else 0)
end

pub fn stop_channel(ch: int) is h2d_stop_channel(ch) end
pub fn pause_music() is h2d_pause_music() end
pub fn resume_music() is h2d_resume_music() end
pub fn is_music_playing() -> bool is return h2d_is_music_playing() != 0 end

pub fn fade_in_music(m: Music, looping: bool, ms: int) is
    h2d_fade_in_music(m.handle, if looping then 1 else 0, ms)
end

pub fn fade_out_music(ms: int) is h2d_fade_out_music(ms) end

;; Volume of ALL sound effects at once (a settings-screen slider), 0..1.
pub fn set_master_volume(volume: f64) is h2d_set_master_volume(volume) end
