pub struct Color is
    pub r: int
    pub g: int
    pub b: int
    pub a: int
end

pub fn color(r: int, g: int, b: int, a: int) -> Color is
    return Color { r: clamp255(r), g: clamp255(g), b: clamp255(b), a: clamp255(a) }
end

pub fn color_rgb(r: int, g: int, b: int) -> Color is
    return color(r, g, b, 255)
end

fn clamp255(v: int) -> int is
    if v < 0 is return 0 end
    if v > 255 is return 255 end
    return v
end

;; Returns a copy of `c` with alpha replaced by `a` (0-255) — handy for
;; fade in/out without re-specifying the rgb every time.
pub fn with_alpha(c: Color, a: int) -> Color is
    return Color { r: c.r, g: c.g, b: c.b, a: clamp255(a) }
end

;; ── palette ──────────────────────────────────────────────────────────

pub fn white()      -> Color is return color_rgb(255, 255, 255) end
pub fn black()       -> Color is return color_rgb(0, 0, 0) end
pub fn blank()       -> Color is return color(0, 0, 0, 0) end
pub fn gray()        -> Color is return color_rgb(130, 130, 130) end
pub fn light_gray()  -> Color is return color_rgb(200, 200, 200) end
pub fn dark_gray()   -> Color is return color_rgb(60, 60, 60) end
pub fn red()         -> Color is return color_rgb(230, 50, 50) end
pub fn green()       -> Color is return color_rgb(60, 200, 90) end
pub fn blue()        -> Color is return color_rgb(60, 120, 230) end
pub fn yellow()      -> Color is return color_rgb(240, 210, 50) end
pub fn orange()      -> Color is return color_rgb(240, 140, 30) end
pub fn purple()      -> Color is return color_rgb(160, 70, 210) end
pub fn magenta()     -> Color is return color_rgb(220, 60, 200) end
pub fn cyan()        -> Color is return color_rgb(50, 210, 210) end
pub fn pink()        -> Color is return color_rgb(240, 130, 180) end
pub fn brown()       -> Color is return color_rgb(140, 95, 55) end
pub fn gold()        -> Color is return color_rgb(255, 200, 40) end
pub fn sky_blue()    -> Color is return color_rgb(110, 180, 240) end
pub fn dark_green()  -> Color is return color_rgb(20, 110, 50) end
pub fn dark_blue()   -> Color is return color_rgb(20, 40, 120) end

;; ── 0.3.0 ───────────────────────────────────────────────────────────

;; 0xRRGGBB integer -> Color (alpha 255). `from_hex(0xff8800)` = orange.
pub fn from_hex(rgb: int) -> Color is
    let r: int = (rgb / 65536) % 256
    let g: int = (rgb / 256) % 256
    let b: int = rgb % 256
    return color_rgb(r, g, b)
end

;; Component-wise blend, t = 0.0 gives `a`, 1.0 gives `b` (alpha blended too).
pub fn lerp(a: Color, b: Color, t: f64) -> Color is
    let k: f64 = if t < 0.0 then 0.0 else if t > 1.0 then 1.0 else t
    return color(
        a.r + __builtin_conv_float_to_int((b.r - a.r + 0.0) * k),
        a.g + __builtin_conv_float_to_int((b.g - a.g + 0.0) * k),
        a.b + __builtin_conv_float_to_int((b.b - a.b + 0.0) * k),
        a.a + __builtin_conv_float_to_int((b.a - a.a + 0.0) * k)
    )
end

;; Brighter (amount 0..1 toward white) / darker (toward black), alpha kept.
pub fn lighten(c: Color, amount: f64) -> Color is
    return with_alpha(lerp(c, white(), amount), c.a)
end

pub fn darken(c: Color, amount: f64) -> Color is
    return with_alpha(lerp(c, black(), amount), c.a)
end

;; Colour from hue (0-360), saturation and value (0..1).
pub fn from_hsv(h: f64, s: f64, v: f64) -> Color is
    let hh: f64 = (h - 360.0 * (__builtin_conv_float_to_int(h / 360.0) + 0.0)) / 60.0
    let i: int = __builtin_conv_float_to_int(hh)
    let f: f64 = hh - (i + 0.0)
    let p: f64 = v * (1.0 - s)
    let q: f64 = v * (1.0 - s * f)
    let t: f64 = v * (1.0 - s * (1.0 - f))
    let mut r: f64 = v
    let mut g: f64 = t
    let mut b: f64 = p
    if i == 1 is
        r = q
        g = v
        b = p
    end
    if i == 2 is
        r = p
        g = v
        b = t
    end
    if i == 3 is
        r = p
        g = q
        b = v
    end
    if i == 4 is
        r = t
        g = p
        b = v
    end
    if i >= 5 is
        r = v
        g = p
        b = q
    end
    return color_rgb(__builtin_conv_float_to_int(r * 255.0), __builtin_conv_float_to_int(g * 255.0), __builtin_conv_float_to_int(b * 255.0))
end
