#[test]
fn test_text_engine_modules() is
    assert_eq(h2d_collision::manhattan(0, 0, 3, 4), 7)
    assert_true(h2d_collision::point_in_rect(1, 1, 0, 0, 2, 2))
    let nx: [int] = h2d_collision::neighbors_x(5)
    let ny: [int] = h2d_collision::neighbors_y(5)
    assert_eq(nx.len(), 4)
    assert_eq(ny[0], 4)
    let mut cam: h2d_camera::Camera = h2d_camera::new_camera(10, 5)
    cam = h2d_camera::follow(cam, 50, 50, 100, 100)
    assert_true(h2d_camera::is_visible(cam, 50, 50))
    assert_eq(h2d_camera::to_screen_x(cam, 50), 5)
    let mut a: h2d_anim::Anim = h2d_anim::new_anim(["a", "b", "c"], 100, true)
    a = h2d_anim::update(a, 250)
    assert_eq(h2d_anim::current_frame(a), "c")
    let map: h2d_tilemap::Tilemap = h2d_tilemap::from_rows(["#####", "#...#", "#####"])
    let path = h2d_pathfind::bfs_path(map, 1, 1, 3, 1, "#")
    assert_true(path.0)
    assert_eq(path.1.len(), 3)
end
